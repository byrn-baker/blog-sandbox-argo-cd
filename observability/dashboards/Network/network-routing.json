{
  "uid": "network-routing",
  "title": "Network Routing",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "network",
    "snmp",
    "routing"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Polled routing health via OpenTelemetry SNMP. State and BGP transitions, not a trap/syslog event archive. Missing peers are checked separately by coverage alerts.",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "network-snmp"
        },
        "definition": "label_values(snmp_interface_oper_status{job=\"snmp\"},device)",
        "query": {
          "query": "label_values(snmp_interface_oper_status{job=\"snmp\"},device)",
          "refId": "device"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "BGP peers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "network-snmp"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "Observed rows in the selected devices. Fleet baseline: 133 BGP peers on 24 devices, 28 IS-IS adjacencies and 56 BFD application rows representing 28 CLI sessions on 10 Cisco routers.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(snmp_bgp_peer_state{job=\"snmp\",device=~\"$device\"}) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "BGP not up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "network-snmp"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "Counts reported non-up states. Missing rows require the coverage checks below.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(snmp_bgp_peer_state{job=\"snmp\",device=~\"$device\"} != 6) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
