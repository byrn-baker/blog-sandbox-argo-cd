    {
      "title": "Disk Space Utilisation",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sort_desc((1 - (max(node_filesystem_avail_bytes{job=\"node-exporter\",fstype!=\"\",instance=\"$instance\",cluster=~\"$cluster\"}) without(mountpoint,fstype) / max(node_filesystem_size_bytes{job=\"node-exporter\",fstype!=\"\",instance=\"$instance\",cluster=~\"$cluster\"}) without(mountpoint,fstype))) != 0)",
