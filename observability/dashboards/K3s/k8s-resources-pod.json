          "expr": "sum(max(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=~\"$cluster\",namespace=\"$namespace\",pod=\"$pod\",container!=\"\"}) by(cluster,namespace,pod,container)) by(container,cluster) / sum(max(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=~\"$cluster\",namespace=\"$namespace\",pod=\"$pod\",container!=\"\"}) by(cluster,namespace,pod,container)) by(container,cluster)",
          "format": "table",
          "instant": true
