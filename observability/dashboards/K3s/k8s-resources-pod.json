          "expr": "sum(max(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=~\"$cluster\",namespace=\"$namespace\",pod=\"$pod\",container!=\"\"}) by(cluster,namespace,pod,container)) by(container,cluster)",
          "format": "table",
