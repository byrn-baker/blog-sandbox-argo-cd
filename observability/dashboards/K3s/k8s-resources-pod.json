        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max(cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=~\"$cluster\",namespace=\"$namespace\",pod=\"$pod\",container!=\"\"}) by(cluster,namespace,pod,container)) by(container,cluster)",
          "format": "table",
          "instant": true
