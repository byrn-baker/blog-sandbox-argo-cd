          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "instance_device:node_disk_io_time_seconds:rate5m{job=\"node-exporter\",cluster=~\"$cluster\"} / scalar(count(instance_device:node_disk_io_time_seconds:rate5m{job=\"node-exporter\",cluster=~\"$cluster\"}) by(cluster))",
