          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(max((node_filesystem_size_bytes{job=\"node-exporter\",fstype!=\"\",mountpoint!=\"\",cluster=~\"$cluster\"} - node_filesystem_avail_bytes{job=\"node-exporter\",fstype!=\"\",mountpoint!=\"\",cluster=~\"$cluster\"}) != 0) without(fstype,mountpoint)) without(device) / scalar(sum(max(node_filesystem_size_bytes{job=\"node-exporter\",fstype!=\"\",mountpoint!=\"\",cluster=~\"$cluster\"}) without(fstype,mountpoint)) by(cluster))",
