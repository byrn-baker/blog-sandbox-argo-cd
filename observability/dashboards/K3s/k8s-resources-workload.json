{
  "title": "Kubernetes / Compute Resources / Workload",
  "editable": false,
  "timezone": "UTC",
  "tags": [
    "kubernetes-mixin",
    "vm-k8s-stack"
  ],
  "annotations": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "definition": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "query": "label_values(kube_namespace_status_phase{job=\"kube-state-metrics\",cluster=~\"$cluster\"}, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "type",
        "label": "workload_type",
        "type": "query",
        "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{cluster=~\"$cluster\",namespace=\"$namespace\"}, workload_type)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "hide": 0,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "workload",
        "label": "workload",
        "type": "query",
        "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{cluster=~\"$cluster\",namespace=\"$namespace\",workload_type=~\"$type\"}, workload)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "hide": 0,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "title": "CPU Usage",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=~\"$cluster\",namespace=\"$namespace\"}) by(cluster,namespace,pod,container) * on(cluster,namespace,pod) group_left(workload,workload_type) namespace_workload_pod:kube_pod_owner:relabel{cluster=~\"$cluster\",namespace=\"$namespace\",workload=~\"$workload\",workload_type=~\"$type\"}) by(pod,cluster)",
          "legendFormat": "__auto"
