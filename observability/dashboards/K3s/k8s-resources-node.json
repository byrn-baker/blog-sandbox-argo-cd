        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=~\"$cluster\",node=~\"$node\"}) by(cluster,namespace,pod,container)) by(pod,cluster) / sum(max(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=~\"$cluster\",node=~\"$node\"}) by(cluster,namespace,pod,container)) by(pod,cluster)",
          "format": "table",
          "instant": true
