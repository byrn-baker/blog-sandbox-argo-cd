          "expr": "sum(max(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=~\"$cluster\",node=~\"$node\"}) by(cluster,namespace,pod,container)) by(pod,cluster)",
          "format": "table",
          "instant": true
