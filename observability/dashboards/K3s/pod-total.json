{
  "title": "Kubernetes / Networking / Pod",
  "editable": false,
  "timezone": "UTC",
  "tags": [
    "kubernetes-mixin",
    "vm-k8s-stack"
  ],
  "annotations": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "definition": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "query": "label_values(container_network_receive_packets_total{cluster=~\"$cluster\"}, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "hide": 0,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "kube-system",
          "value": "kube-system"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "query": "label_values(container_network_receive_packets_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}, pod)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "current": {
          "selected": false,
          "text": "kube-system",
          "value": "kube-system"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Current Rate of Bits Received",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(8 * rate(container_network_receive_bytes_total{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) by(cluster)",
          "legendFormat": "__auto"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "$pod",
          "max": 10000000000,
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "color": "dark-green",
                "index": 0,
                "value": null
              },
              {
                "color": "dark-yellow",
                "index": 1,
                "value": 5000000000
              },
              {
                "color": "dark-red",
                "index": 2,
                "value": 7000000000
              }
            ]
          },
          "unit": "bps"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "pluginVersion": "v13.0.0",
      "type": "gauge"
    },
    {
      "title": "Current Rate of Bits Transmitted",
