{
  "title": "Kubernetes / Persistent Volumes",
  "editable": false,
  "timezone": "UTC",
  "tags": [
    "kubernetes-mixin",
    "vm-k8s-stack"
  ],
  "annotations": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "constant",
        "query": ".*",
        "definition": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "query": "label_values(kubelet_volume_stats_capacity_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\"}, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "volume",
        "label": "PersistentVolumeClaim",
        "type": "query",
        "query": "label_values(kubelet_volume_stats_capacity_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\"}, persistentvolumeclaim)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "title": "Volume Space Usage",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(topk(1, kubelet_volume_stats_capacity_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) without(instance,node) - sum(topk(1, kubelet_volume_stats_available_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) without(instance,node)",
          "legendFormat": "Used Space"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(topk(1, kubelet_volume_stats_available_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) without(instance,node)",
          "legendFormat": "Free Space"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Volume Space Usage",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(((topk(1, kubelet_volume_stats_capacity_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster) - topk(1, kubelet_volume_stats_available_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) / topk(1, kubelet_volume_stats_capacity_bytes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) * 100) without(instance,node)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 2,
      "interval": "1m",
      "pluginVersion": "v13.0.0",
      "type": "gauge"
    },
    {
      "title": "Volume inodes Usage",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(topk(1, kubelet_volume_stats_inodes_used{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) without(instance,node)",
          "legendFormat": "Used inodes"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(topk(1, kubelet_volume_stats_inodes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) without(instance,node) - sum(topk(1, kubelet_volume_stats_inodes_used{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) without(instance,node)",
          "legendFormat": "Free inodes"
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "y": 7
      },
      "id": 3,
      "interval": "1m",
      "options": {
        "legend": {
          "asTable": true,
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "v13.0.0",
      "type": "timeseries"
    },
    {
      "title": "Volume inodes Usage",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max((topk(1, kubelet_volume_stats_inodes_used{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster) / topk(1, kubelet_volume_stats_inodes{cluster=~\"$cluster\",job=\"kubelet\",metrics_path=\"/metrics\",namespace=\"$namespace\",persistentvolumeclaim=\"$volume\"}) by(cluster)) * 100) without(instance,node)",
          "instant": true
        }
      ],
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "id": 4,
      "interval": "1m",
      "pluginVersion": "v13.0.0",
      "type": "gauge"
    }
  ],
  "links": [
    {
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "kubernetes-mixin"
      ],
      "targetBlank": false,
      "title": "Kubernetes",
      "type": "dashboards"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
